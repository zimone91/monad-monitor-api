// markdownlint-cli2 settings for the docs-lint job. Every rule is on except
// the ones below, and each exception names its reason.
{
  "default": true,

  // Prose is written one sentence per line, so diffs stay small; lines are
  // not wrapped at a fixed width.
  "MD013": false,

  // Keep a Changelog repeats "### Added", "### Changed" ... under every
  // release; a heading only has to be unique among its siblings.
  "MD024": { "siblings_only": true },

  // Tables use the common GitHub form: padded cells and a |---| delimiter row.
  // MD060 has no style for that mix and would flag every table.
  "MD060": false
}
